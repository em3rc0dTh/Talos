{
  "schemaVersion": "talos.module-boundaries.v1",
  "workspacePrefix": "@talos/",
  "modules": [
    {"name":"foundation","root":"packages/foundation","allowedInternalImports":[],"allowedExternalPackages":["zod"]},
    {"name":"source-intake","root":"packages/source-intake","allowedInternalImports":["foundation"],"allowedExternalPackages":["zod"]},
    {"name":"canvas-source","root":"packages/canvas-source","allowedInternalImports":["foundation","source-intake"],"allowedExternalPackages":["zod"]},
    {"name":"image-perception","root":"packages/image-perception","allowedInternalImports":["foundation","source-intake"],"allowedExternalPackages":["zod"]},
    {"name":"semantic-core","root":"packages/semantic-core","allowedInternalImports":["foundation"],"allowedExternalPackages":["zod"]},
    {"name":"review","root":"packages/review","allowedInternalImports":["foundation","semantic-core","canvas-source"],"allowedExternalPackages":["zod"]},
    {"name":"capability","root":"packages/capability","allowedInternalImports":["foundation","semantic-core","review"],"allowedExternalPackages":["zod"]},
    {"name":"execution","root":"packages/execution","allowedInternalImports":["foundation","semantic-core","review","capability"],"allowedExternalPackages":["zod"]},
    {"name":"temporal-design","root":"packages/temporal-design","allowedInternalImports":["foundation","execution"],"allowedExternalPackages":["zod"]},
    {"name":"runtime-policy","root":"packages/runtime-policy","allowedInternalImports":["foundation","execution","temporal-design"],"allowedExternalPackages":["zod"]},
    {"name":"deployment","root":"packages/deployment","allowedInternalImports":["foundation","capability","execution","temporal-design","runtime-policy"],"allowedExternalPackages":["zod"]},
    {"name":"application","root":"packages/application","allowedInternalImports":["foundation","source-intake","canvas-source","image-perception","semantic-core","review","capability","execution","temporal-design","runtime-policy","deployment"],"allowedExternalPackages":["zod"]},
    {"name":"persistence-sqlite","root":"packages/persistence-sqlite","allowedInternalImports":["foundation","source-intake","semantic-core","review","capability","execution","temporal-design","runtime-policy","deployment","application"],"allowedExternalPackages":["better-sqlite3","zod"]},
    {"name":"reference-email-sink","root":"packages/reference-email-sink","allowedInternalImports":["foundation"],"allowedExternalPackages":["better-sqlite3","zod"]},
    {"name":"reference-api","root":"apps/reference-api","allowedInternalImports":["foundation","application","persistence-sqlite","deployment","reference-email-sink","reference-temporal-worker"],"allowedExternalPackages":["@temporalio/client","@temporalio/testing","zod"]},
    {"name":"reference-web","root":"apps/reference-web","allowedInternalImports":[],"allowedExternalPackages":[]},
    {"name":"reference-temporal-worker","root":"workers/reference-temporal-worker","allowedInternalImports":["foundation","execution","temporal-design","runtime-policy","deployment","reference-email-sink"],"allowedExternalPackages":["@temporalio/common","@temporalio/worker","@temporalio/workflow","@temporalio/activity","zod"]}
  ],
  "globalRules": {
    "domainModulesForbiddenExternalPrefixes": ["@temporalio/"],
    "temporalSdkAllowedModules": ["reference-api","reference-temporal-worker"],
    "sqliteAllowedModules": ["persistence-sqlite","reference-email-sink"],
    "forbiddenCrossLayerIdentityRule": "Canonical/source/review/capability/execution/deployment identities remain branded and non-reusable across layers.",
    "workflowForbiddenResources": ["Talos SQLite","reference provider SQLite","filesystem","HTTP/provider calls","latest mutable Talos design"]
  }
}
