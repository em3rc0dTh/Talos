{
  "name": "@talos/reference-vertical-slice",
  "version": "0.0.0-reference",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "b0:verify": "node ./scripts/verify-b0.mjs",
    "architecture:verify": "node ./scripts/verify-architecture.mjs",
    "b1:test": "node --experimental-strip-types --test ./tests/b1-*.test.ts",
    "b1:verify": "npm run architecture:verify && npm run b1:test",
    "b2:test": "node --experimental-strip-types --test ./tests/b2-*.test.ts",
    "b2:verify": "npm run architecture:verify && npm run b1:test && npm run b2:test",
    "test": "npm run b2:verify"
  }
}
