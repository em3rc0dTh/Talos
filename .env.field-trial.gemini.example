# Copy to .env.field-trial.gemini and set the key locally.
# Never commit the populated file.
GEMINI_API_KEY=

# Ordered failover. Talos tries the next model only when the previous route
# cannot return evidence that passes the existing Talos perception contract.
GEMINI_MODEL_CHAIN=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash

# Bounded per-model request budget. The One-App UI keeps elapsed time visible.
GEMINI_TIMEOUT_MS=45000

# Whole-chain budget at the Talos provider boundary.
TALOS_IMAGE_PERCEPTION_TIMEOUT_MS=330000
