# Copy to .env.field-trial.gemini and set the key locally.
# Never commit the populated file.
GEMINI_API_KEY=

# Ordered failover for real multimodal field trials. The compact visual-graph
# protocol keeps model output small; Talos expands it deterministically into
# the full perception-evidence contract after the model returns.
GEMINI_MODEL_CHAIN=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-3.6-flash

# Real image inference can exceed 15 seconds. Four candidates at this bound
# fit inside the whole-chain budget and the Talos 120-second provider ceiling.
GEMINI_TIMEOUT_MS=25000
GEMINI_CHAIN_BUDGET_MS=110000

# Whole-chain boundary enforced by Talos. The runtime contract accepts
# 1000..120000 ms inclusive, so never set this above 120000.
TALOS_IMAGE_PERCEPTION_TIMEOUT_MS=120000

# Keep the base URL at the API host root. The gateway appends /v1beta/models/...
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
