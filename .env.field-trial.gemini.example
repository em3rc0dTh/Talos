# Copy to .env.field-trial.gemini and set the key locally.
# Never commit the populated file.
GEMINI_API_KEY=

# Ordered failover. Talos tries the next model only when the previous route
# cannot return evidence that passes the existing Talos perception contract.
GEMINI_MODEL_CHAIN=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash

# Bounded per-model request budget. Six default candidates fit inside the
# Talos provider boundary while the One-App UI keeps elapsed time visible.
GEMINI_TIMEOUT_MS=15000

# Whole-chain budget at the Talos provider boundary. The runtime contract
# accepts 1000..120000 ms inclusive, so never set this above 120000.
TALOS_IMAGE_PERCEPTION_TIMEOUT_MS=120000
