FROM node:22-bookworm-slim

WORKDIR /workspace/build/reference-vertical-slice

COPY build/reference-vertical-slice/package.json ./
COPY build/reference-vertical-slice/package-lock.json ./

# Field-trial builds must tolerate transient registry slowness without changing
# the exact dependency graph pinned by package-lock.json. Keep npm ci, but give
# the registry transport bounded retries and a realistic read timeout.
RUN npm config set fetch-retries 5 \
  && npm config set fetch-retry-factor 2 \
  && npm config set fetch-retry-mintimeout 20000 \
  && npm config set fetch-retry-maxtimeout 120000 \
  && npm config set fetch-timeout 300000 \
  && npm ci --no-audit --no-fund

COPY build/reference-vertical-slice ./

ENV HOST=0.0.0.0
ENV PORT=8787
ENV TALOS_RUNTIME_DIR=/data/talos-runtime
ENV TEMPORAL_ADDRESS=temporal:7233
ENV TEMPORAL_NAMESPACE=default

EXPOSE 8787

CMD ["node", "--experimental-strip-types", "./apps/reference-api/src/field-trial-product-server.ts"]
